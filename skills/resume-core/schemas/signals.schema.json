{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence clusters and their signals (04-projects/signals.json)",
  "type": "object",
  "required": ["evidence_sha256", "clusters", "reviews"],
  "additionalProperties": false,
  "properties": {
    "evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "clusters": {"type": "array", "items": {"$ref": "#/$defs/cluster"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}}
  },
  "$defs": {
    "evidenceId": {"type": "string", "pattern": "^ev_[0-9a-f]{8}([0-9a-f]{4})?$"},
    "evidenceIds": {"type": "array", "items": {"$ref": "#/$defs/evidenceId"}},
    "clusterId": {"type": "string", "pattern": "^c[1-9][0-9]*$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "count": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "cluster": {
      "type": "object",
      "required": ["id", "label", "evidence_ids", "start", "end", "days", "kinds", "authored", "reviewed",
                   "assigned", "reported", "stats", "repos", "jira_projects", "contributors", "epics",
                   "epics_created", "first_authored_at", "authored_first", "open_items", "review_mentions"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/clusterId"},
        "label": {"type": "string"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceId"}},
        "start": {"$ref": "#/$defs/date"},
        "end": {"$ref": "#/$defs/date"},
        "days": {"$ref": "#/$defs/count"},
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pr": {"$ref": "#/$defs/positive"},
            "mr": {"$ref": "#/$defs/positive"},
            "commit": {"$ref": "#/$defs/positive"},
            "review": {"$ref": "#/$defs/positive"},
            "issue": {"$ref": "#/$defs/positive"},
            "ticket": {"$ref": "#/$defs/positive"},
            "epic": {"$ref": "#/$defs/positive"}
          }
        },
        "authored": {"$ref": "#/$defs/count"},
        "reviewed": {"$ref": "#/$defs/count"},
        "assigned": {"$ref": "#/$defs/count"},
        "reported": {"$ref": "#/$defs/count"},
        "stats": {
          "type": "object",
          "required": ["additions", "deletions", "files"],
          "additionalProperties": false,
          "properties": {
            "additions": {"$ref": "#/$defs/count"},
            "deletions": {"$ref": "#/$defs/count"},
            "files": {"$ref": "#/$defs/count"}
          }
        },
        "repos": {"$ref": "#/$defs/names"},
        "jira_projects": {"$ref": "#/$defs/names"},
        "contributors": {"$ref": "#/$defs/count"},
        "epics": {"$ref": "#/$defs/evidenceIds"},
        "epics_created": {"$ref": "#/$defs/evidenceIds"},
        "first_authored_at": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "authored_first": {"type": "boolean"},
        "open_items": {"$ref": "#/$defs/count"},
        "review_mentions": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "review": {
      "type": "object",
      "required": ["id", "title", "date", "raw_ref", "clusters"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/evidenceId"},
        "title": {"type": "string"},
        "date": {"$ref": "#/$defs/date"},
        "raw_ref": {"type": ["string", "null"]},
        "clusters": {"type": "array", "items": {"$ref": "#/$defs/clusterId"}}
      }
    }
  }
}
