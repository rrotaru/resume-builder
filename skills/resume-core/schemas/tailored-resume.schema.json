{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailored resume (08-ats/general/resume.json, 08-ats/jobs/<slug>/resume.json)",
  "description": "The only input to rendering. Every object is closed to an allowlist of fields. Every work and projects entry carries x-highlights; claims live only in sourced highlights and the sourced summary (presence is enforced by check_sources.py). check_sources.py also matches every other field against the profile, so entries carry no x-sources.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "url": {"type": "string"},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {"type": "string"},
            "postalCode": {"type": "string"},
            "city": {"type": "string"},
            "countryCode": {"type": "string"},
            "region": {"type": "string"}
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "network": {"type": "string"},
              "username": {"type": "string"},
              "url": {"type": "string"}
            }
          }
        },
        "summary": {"type": "string", "minLength": 1},
        "x-summary-sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
      }
    },
    "work": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "education": {"type": "array", "items": {"$ref": "#/$defs/education"}},
    "certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "sourceRef": {
      "type": "string",
      "pattern": "^(ev_[0-9a-f]{8}([0-9a-f]{4})?|metric:m_[A-Za-z0-9_-]+|resume:/.*|wizard:/.*)$"
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
    "education": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution": {"type": "string"},
        "url": {"type": "string"},
        "area": {"type": "string"},
        "studyType": {"type": "string"},
        "startDate": {"$ref": "#/$defs/date"},
        "endDate": {"$ref": "#/$defs/date"},
        "score": {"type": "string"}
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "date": {"$ref": "#/$defs/date"},
        "issuer": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "level": {"type": "string"},
        "keywords": {"type": "array", "items": {"type": "string"}}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x-highlights"],
      "properties": {
        "name": {"type": "string"},
        "position": {"type": "string"},
        "url": {"type": "string"},
        "location": {"type": "string"},
        "startDate": {"$ref": "#/$defs/date"},
        "endDate": {"$ref": "#/$defs/date"},
        "highlights": {"type": "array", "items": {"type": "string"}},
        "x-highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bullet_id", "text", "sources"],
            "additionalProperties": false,
            "properties": {
              "bullet_id": {"type": "string", "pattern": "^b_[A-Za-z0-9_-]+$"},
              "text": {"type": "string", "minLength": 1},
              "sources": {"$ref": "#/$defs/sources"}
            }
          }
        }
      }
    }
  }
}
